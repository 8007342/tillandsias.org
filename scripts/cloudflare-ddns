#!/usr/bin/env bash
# cloudflare-ddns for tillandsias.org
#
# Keeps A (IPv4) and AAAA (IPv6) records pointed at the current public addresses,
# with a short TTL (1 hour) since we serve from dynamic IPs. Apex is canonical;
# www is also managed (it redirects to the apex). Runs on the dev host and inside
# the container at runtime.
#
# Credentials are NEVER baked into the image or committed to the repo. The
# CloudFlare API token is provided at runtime via one of:
#   --token-file <path>    (default $CF_TOKEN_FILE, or podman secret mount)
#   --token <value>        (or $CLOUDFLARE_API_TOKEN / $CF_API_TOKEN)
#
# Modes:
#   --dry-run              print what would change without calling write APIs
#   --validate             check token + zone lookup, no writes (implies dry-run)
#
# Usage:
#   cloudflare-ddns [--dry-run|--validate] [--token-file F] [--token V] \
#                   [--zone Z] [--hostnames H1,H2] [--types A,AAAA] [--ttl N]
set -euo pipefail

API_BASE="${CF_API_BASE:-https://api.cloudflare.com/client/v4}"

MODE="live"
TOKEN_FILE="${CF_TOKEN_FILE:-}"
TOKEN="${CF_TOKEN_VAL:-}"
ZONE="${CF_ZONE:-tillandsias.org}"
# apex and www are the managed hosts; apex is canonical (www redirects to it).
# The wildcard is not DNS-updated (reserved for certbot DNS-01 TXT later).
HOSTNAMES="${CF_HOSTNAMES:-tillandsias.org,www.tillandsias.org}"
# Short TTL (1 hour): we serve from dynamic IPs and update these records often.
TTL="${CF_TTL:-3600}"
# Record types to keep current: A (IPv4) and AAAA (IPv6).
RECORD_TYPES="${CF_RECORD_TYPES:-A,AAAA}"
PUBLIC_IP4_PROVIDERS=(
  "https://api.ipify.org"
  "https://api4.ipify.org"
)
PUBLIC_IP6_PROVIDERS=(
  "https://api6.ipify.org"
  "https://api64.ipify.org"
)

usage() {
  # print the leading #-comment block of this file as usage text
  sed -n '2,20p' "$0" | sed -n '/^#/{s/^# //; s/^#$//; p}' >&2
}

die() { echo "error: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) MODE="dry-run"; shift ;;
    --validate) MODE="validate"; shift ;;
    --token-file) TOKEN_FILE="$2"; shift 2 ;;
    --token) TOKEN="$2"; shift 2 ;;
    --zone) ZONE="$2"; shift 2 ;;
    --hostnames) HOSTNAMES="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

resolve_token() {
  [ -n "$TOKEN" ] && return
  [ -n "${CLOUDFLARE_API_TOKEN:-}" ] && TOKEN="$CLOUDFLARE_API_TOKEN" && return
  [ -n "${CF_API_TOKEN:-}" ] && TOKEN="$CF_API_TOKEN" && return
  [ -n "$TOKEN_FILE" ] && [ -f "$TOKEN_FILE" ] && {
    TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"; return
  }
  # Common podman secret default mount
  [ -f /run/secrets/cf-token ] && TOKEN="$(tr -d '[:space:]' < /run/secrets/cf-token)" && return
  die "no CloudFlare token found (use --token, --token-file, \$CLOUDFLARE_API_TOKEN, or podman secret)"
}

get_public_ip4() {
  local p ip
  for p in "${PUBLIC_IP4_PROVIDERS[@]}"; do
    if ip="$(curl -fsSL --max-time 10 "$p" 2>/dev/null)"; then
      ip="$(printf '%s' "$ip" | head -n1 | tr -d '[:space:]')"
      [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && { echo "$ip"; return 0; }
    fi
  done
  return 1
}

get_public_ip6() {
  local p ip
  for p in "${PUBLIC_IP6_PROVIDERS[@]}"; do
    if ip="$(curl -fsSL --max-time 10 "$p" 2>/dev/null)"; then
      ip="$(printf '%s' "$ip" | head -n1 | tr -d '[:space:]')"
      # accept an IPv6 address (contains a colon)
      [[ "$ip" =~ : ]] && { echo "$ip"; return 0; }
    fi
  done
  return 1
}

API_BODY=""
API_CODE=""
api_get() { # $1: path; sets $API_BODY and $API_CODE
  local resp code
  # run curl under its own errstate so failures don't trip `set -e` here
  set +e
  resp="$(curl -sS --max-time 20 -H "Authorization: Bearer ${TOKEN}" \
          -H "Content-Type: application/json" -w $'\n%{http_code}' "$API_BASE$1" 2>/dev/null)"
  code=$?
  set -e
  [ "$code" -eq 0 ] || { API_BODY=""; API_CODE="000"; return 1; }
  API_CODE="${resp##*$'\n'}"
  API_BODY="${resp%$'\n'*}"
}

api_ok() { [ "$API_CODE" = "200" ]; }

log() { echo "$*"; }
warn() { echo "warning: $*" >&2; }

main() {
  resolve_token

  # --- Validate token / find zone (no writes) ---
  if ! api_get "/zones?name=$(printf '%s' "$ZONE" | sed 's/[*]/\\*/g')&status=active" || ! api_ok; then
    [ -n "$API_BODY" ] && msg="$(jq -r '.errors[0].message // .errors[0].code // "invalid response"' <<<"$API_BODY" 2>/dev/null || echo "invalid response")" || msg="no response"
    die "CloudFlare API call failed HTTP=$API_CODE ($msg); check token"
  fi
  zones="$API_BODY"
  jq -e '.success == true' <<<"$zones" >/dev/null 2>&1 ||
    die "CloudFlare API call failed (bad token/network?)"
  zone_id="$(jq -r '.result[0].id // empty' <<<"$zones")"
  [ -n "$zone_id" ] || die "zone '$ZONE' not found or not active"

  log "zone: $ZONE ($zone_id)"
  if [ "$MODE" = "validate" ]; then
    log "ok: token valid and zone '$ZONE' resolved (validate mode, no changes)"
    return 0
  fi

  # Determine current public addresses for each requested record type.
  ip4="" ip6=""
  if [[ ",$RECORD_TYPES," == *,A,* ]]; then
    if ip4="$(get_public_ip4)"; then
      log "public IPv4: $ip4  (mode: $MODE)"
    else
      log "warning: could not determine public IPv4; skipping A records"
    fi
  fi
  if [[ ",$RECORD_TYPES," == *,AAAA,* ]]; then
    if ip6="$(get_public_ip6)"; then
      log "public IPv6: $ip6  (mode: $MODE)"
    else
      log "warning: could not determine public IPv6; skipping AAAA records"
    fi
  fi

  IFS=',' read -r -a hosts <<<"$HOSTNAMES"
  local changed=0
  for host in "${hosts[@]}"; do
    for type in A AAAA; do
      [[ ",$RECORD_TYPES," == *,$type,* ]] || continue
      if [ "$type" = "A" ]; then
        ip="$ip4"; [ -n "$ip" ] || continue
      else
        ip="$ip6"; [ -n "$ip" ] || continue
      fi

      enc_name="$(printf '%s' "$host" | sed 's/[*]/%2A/g')"
      if ! api_get "/zones/$zone_id/dns_records?type=$type&name=$enc_name" || ! api_ok; then
        warn "failed to list $type records for $host (HTTP=$API_CODE)"
        continue
      fi
      records="$API_BODY"
      jq -e '.success == true' <<<"$records" >/dev/null 2>&1 ||
        { warn "failed to list $type records for $host"; continue; }

      # current records for this host: "<id> <content>" per row
      mapfile -t rows < <(jq -r '.result[] | "\(.id) \(.content)"' <<<"$records")

      if [ "${#rows[@]}" -eq 0 ]; then
        # No record exists yet -- create one with a short TTL.
        if [ "$MODE" = "dry-run" ]; then
          log "would create $type $host -> $ip (ttl=$TTL, dry-run)"
        else
          set +e
          resp="$(curl -sS --max-time 20 -X POST \
            -H "Authorization: Bearer ${TOKEN}" \
            -H "Content-Type: application/json" \
            "$API_BASE/zones/$zone_id/dns_records" \
            -d "{\"type\":\"$type\",\"name\":\"$host\",\"content\":\"$ip\",\"ttl\":$TTL}" 2>/dev/null)"
          rc=$?
          set -e
          if [ "$rc" -eq 0 ] && jq -e '.success == true' <<<"$resp" >/dev/null 2>&1; then
            log "created $type $host -> $ip"
            changed=$((changed + 1))
          else
            warn "failed to create $type $host: $(jq -r '.errors[0].message // "unknown"' <<<"$resp" 2>/dev/null || echo "HTTP error")"
          fi
        fi
        continue
      fi

      # update existing records (handle multiple by id), refresh TTL
      for row in "${rows[@]}"; do
        id="${row%% *}"
        cur_ip="${row#* }"
        [ -n "$id" ] || continue
        if [ "$cur_ip" = "$ip" ]; then
          log "$type $host = $cur_ip (up to date)"
          continue
        fi
        if [ "$MODE" = "dry-run" ]; then
          log "would update $type $host $cur_ip -> $ip (dry-run)"
        else
          set +e
          resp="$(curl -sS --max-time 20 -X PATCH \
            -H "Authorization: Bearer ${TOKEN}" \
            -H "Content-Type: application/json" \
            "$API_BASE/zones/$zone_id/dns_records/$id" \
            -d "{\"content\":\"$ip\",\"ttl\":$TTL}" 2>/dev/null)"
          rc=$?
          set -e
          if [ "$rc" -eq 0 ] && jq -e '.success == true' <<<"$resp" >/dev/null 2>&1; then
            log "updated $type $host $cur_ip -> $ip"
            changed=$((changed + 1))
          else
            warn "failed to update $type $host: $(jq -r '.errors[0].message // "unknown"' <<<"$resp" 2>/dev/null || echo "HTTP error")"
          fi
        fi
      done
    done
  done

  [ "$MODE" = "live" ] && [ "$changed" -gt 0 ] && log "$changed record(s) updated."
  return 0
}

main "$@"
