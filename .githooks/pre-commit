#!/usr/bin/env bash
# Keep the committed static site equal to its checked source.  The build writes
# var/html/index.html; compare it with the index afterward so a commit cannot
# deploy an old release pin or an old generated date.
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
"$ROOT/skills/update-website/scripts/checked-build.sh"

if ! git -C "$ROOT" diff --quiet -- var/html/index.html; then
  echo "blocked:generated-site-is-stale — stage var/html/index.html after the checked build" >&2
  exit 1
fi
